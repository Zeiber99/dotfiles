[global]
    font = JetBrainsMono Nerd Font 10
    corner_radius = 12
    width = (280, 380)
    offset = 15x15
    notification_limit = 5
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#7aa2f7"
    background = "#1a1b26e6"
    foreground = "#c0caf5"

[urgency_low]
    background = "#1a1b26e6"
    foreground = "#a9b1d6"

[urgency_normal]
    background = "#1a1b26e6"
    foreground = "#c0caf5"

[urgency_critical]
    background = "#1a1b26e6"
    foreground = "#f7768e"
    frame_color = "#f7768e"
