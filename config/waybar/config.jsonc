{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 4,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "memory",
        "pulseaudio",
        "backlight",
        "bluetooth",
        "network",
        "tray",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },
    "hyprland/window": {
        "max-length": 35
    },
    "clock": {
        "format": "󰥔 {:%H:%M  •  %d/%m/%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "memory": {
        "interval": 2,
        "format": "󰍛 {used:0.1f}GB",
        "tooltip-format": "RAM en uso: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Mudo",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },
    "backlight": {
        "device": "amdgpu_bl0",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },
    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀 Conectado",
        "format-disconnected": "󰖪 Desconectado",
        "tooltip-format": "{essid} ({ipaddr})"
    },
    "bluetooth": {
        "format": "󰂯 BT",
        "format-disabled": "󰂲 Off",
        "format-off": "󰂲 Off",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} conectados",
        "on-click": "blueman-manager"
    },
    "tray": {
        "spacing": 10
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
